# KisanOS AI Environment Configuration

# Application
APP_NAME=KisanOS AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api

# Security / Auth
SECRET_KEY=change-this-super-secret-key-for-production-min-32-chars-kisanos
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://kisanos-frontend.onrender.com

# Database Configuration (PostgreSQL primary production DB)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kisanos
# Primary production connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kisanos
# SQLite development/demo fallback enabled if PostgreSQL connection is unreachable
ALLOW_SQLITE_FALLBACK=True
SQLITE_DB_PATH=kisanos_dev.db

# Seed / Demo Configuration (Configurable, not hard-coded)
DEMO_FARMER_NAME="Ramesh Patel (रामेश पटेल)"
DEMO_FARMER_PHONE="9876543210"
DEMO_FARMER_PASSWORD="Password123!"
DEMO_FARMER_LANGUAGE="hi"
DEMO_FARMER_LOCATION="Sehore, Madhya Pradesh (सीहोर, मध्य प्रदेश)"

DEMO_FARM_NAME="North Field A (उत्तर खेत A)"
DEMO_FARM_LOCATION="Sehore District, Madhya Pradesh"
DEMO_FARM_LAT=23.2033
DEMO_FARM_LON=77.0844
DEMO_FARM_AREA_ACRES=2.5
DEMO_SOIL_TYPE="Black loamy soil (काली दोमट मिट्टी)"
DEMO_SOIL_PH=6.8
DEMO_IRRIGATION_TYPE="Tubewell + Drip (नलकूप + ड्रिप सिंचाई)"
DEMO_CURRENT_CROP="Wheat (गेहूं - Sharbati)"
DEMO_CURRENT_STAGE="Tillering (कल्ले फूटने की अवस्था)"

# AI Providers (Optional - Abstraction layer with deterministic offline fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=fallback

# External Providers (Optional - Abstraction layer with seeded fallback)
WEATHER_API_KEY=
MANDI_API_KEY=
STORAGE_PROVIDER=local
STORAGE_DIR=./uploads
